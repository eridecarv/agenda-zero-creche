# .env.example
# Copy this file to .env.local and fill in the real values.

# Supabase project URL and publishable key (safe to expose client-side)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key — server-only, full DB access, bypasses RLS.
# Never expose this to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# App's own base URL — used server-side to build absolute links (e.g. guardian invite links).
# http://localhost:3000 in development; the real domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000